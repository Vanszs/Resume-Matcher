// Default config for SQLite, can be changed to PostgreSQL later
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator pyclient {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

// ----------------------------------------------------------------------
// ROLE MODEL (RBAC)
// ----------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "admin", "manager", "staff"
  
  // Storing permissions as a JSON array of strings e.g., ["create_user", "edit_role"]
  // (In SQLite it is stored as a String, in Postgres it can be native Json API)
  permissions String   @default("[]") 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  users       User[]   @relation("UserRole")
}

// ----------------------------------------------------------------------
// USER MODEL
// ----------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  
  // Hashed password string from bcrypt/argon2
  passwordHash String   
  
  // Status to disable/block a user
  isActive     Boolean  @default(true)
  
  // Email verification status
  isVerified   Boolean  @default(false)

  // Foreign Key to the Role model
  roleId       String
  role         Role     @relation("UserRole", fields: [roleId], references: [id])

  // Optional: Track which admin created this user
  createdById  String?
  createdBy    User?    @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers User[]   @relation("UserCreator")

  // API Keys / LLM Configuration
  llmConfigs   LLMConfig[]
  
  // OTP Verification Tokens
  verificationTokens VerificationToken[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ----------------------------------------------------------------------
// VERIFICATION TOKEN MODEL (OTP)
// ----------------------------------------------------------------------

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // The 6-digit OTP code (e.g. "931024")
  token     String   
  
  // e.g., "EMAIL_VERIFICATION", "PASSWORD_RESET"
  type      String   
  
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  
  createdAt DateTime @default(now())

  // Fast lookups when retrieving the active OTP for a specific user and type
  @@index([userId, type])
}

// ----------------------------------------------------------------------
// LLM CONFIG MODEL (USER API KEYS)
// ----------------------------------------------------------------------

model LLMConfig {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // e.g., "openai", "anthropic", "openrouter", "google", "deepseek", "ollama"
  provider     String   
  
  // Stored API key (Optional for local models like Ollama)
  apiKey       String?   
  
  // The selected model (e.g., "gpt-4o")
  model        String?
  
  // Custom Base URL (e.g., "http://localhost:11434" for Ollama)
  baseUrl      String?  
  
  // Whether this is the user's currently active/selected provider
  isDefault    Boolean  @default(false) 

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Ensures a user only has one configuration per provider type
  @@unique([userId, provider]) 
}
